
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  STAFF
  HOD
  STORES
  AUDIT
  FINANCE
  ADMIN
  IT_ADMIN
}

enum RequisitionTypes {
  GENERAL
  TONER
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  HOD_APPROVED
  AUDIT_CERTIFIED
  FINANCE_APPROVED
  STORES_COSTED
  ISSUED
  COMPLETED
  REJECTED
  AWAITING_IT_VERIFICATION
  IT_VERIFIED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum AuditDecision {
  CERTIFIED
  REJECTED
}



enum ITDecision {
  CERTIFIED
  REJECTED

}

enum FinanceDecision {
  APPROVED
  REJECTED
}

enum RequisitionAction {
  CREATED
  SUBMITTED
  HOD_APPROVED
  HOD_REJECTED
  AUDIT_CERTIFIED
  AUDIT_REJECTED
  FINANCE_APPROVED
  FINANCE_REJECTED
  ISSUED
  RECEIVED
  COMPLETED
  REJECTED
  EVIDENCE_REQUESTED
  EVIDENCE_SUBMITTED
  EVIDENCE_RECEIVED
  EVIDENCE_ACCEPTED
  EVIDENCE_REJECTED
}

enum EvidenceStatus {
  REQUESTED
  STAFF_SUBMITTED
  RECEIVED
  ACCEPTED
  REJECTED
}

// =========================
// 1. DEPARTMENT
// =========================

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// 2. USER
// =========================

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  EmployeeCode        String?  @unique
  firstname           String
  middlename          String
  lastname            String
  phone               String   @unique
  email               String   @unique
  password            String
  role                UserRole @default(STAFF)

  departmentId        String?     @db.Uuid
  department          Department? @relation(fields: [departmentId], references: [id])

  createdRequisitions Requisition[]          @relation("CreatedRequisitions")
  approvals           RequisitionApproval[]
  auditVerifications  AuditVerification[]
  IT  ITVerification[]

  financeApprovals    FinanceApproval[]
  issuances           RequisitionIssuance[]
  receipts            RequisitionReceipt[]
  history             RequisitionHistory[]

  // Evidence request relations
  evidenceRequestsCreated EvidenceRequest[] @relation("EvidenceRequestedBy")
  evidenceSubmissions     EvidenceRequest[] @relation("EvidenceSubmittedBy")
  evidenceReceipts        EvidenceRequest[] @relation("EvidenceReceivedBy")
  evidenceReviews         EvidenceRequest[] @relation("EvidenceReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// 3. REQUISITION
// =========================

model Requisition {
  id            String           @id @default(uuid()) @db.Uuid
  requisitionNo String           @unique
  createdById   String           @db.Uuid
  date          DateTime
  status        RequisitionStatus @default(DRAFT)
  reason        String
  requisitionType RequisitionTypes?

  createdBy User? @relation("CreatedRequisitions", fields: [createdById], references: [id])

  // Keep your existing notes field
  notes String?

  items RequisitionItem[]

  approval RequisitionApproval?
  audit    AuditVerification[]
  IT ITVerification[]
  finance  FinanceApproval[]
  issuance RequisitionIssuance?
  receipt  RequisitionReceipt?
  history  RequisitionHistory[]

  // New evidence requests relation
  evidenceRequests EvidenceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// 4. REQUISITION ITEM
// =========================

model RequisitionItem {
  id                String   @id @default(uuid()) @db.Uuid
  requisitionId     String   @db.Uuid
  description       String
  quantityRequested Int
  quantityIssued    Int?
  unitCost          Decimal? @db.Decimal(12, 2)
  totalCost         Decimal? @db.Decimal(12, 2)

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// 5. HOD APPROVAL
// =========================

model RequisitionApproval {
  id            String           @id @default(uuid()) @db.Uuid
  requisitionId String           @unique @db.Uuid
  approvedById  String           @db.Uuid
  decision      ApprovalDecision
  comment       String?
  approvedAt    DateTime         @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approvedBy  User        @relation(fields: [approvedById], references: [id])
}

// =========================
// 6. INTERNAL AUDIT
// =========================

model AuditVerification {
  id            String       @id @default(uuid()) @db.Uuid
  requisitionId String       @db.Uuid
  auditorId     String       @db.Uuid
  decision      AuditDecision
  comment       String?
  verifiedAt    DateTime     @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  auditor     User        @relation(fields: [auditorId], references: [id])
}




model ITVerification {
  id            String       @id @default(uuid()) @db.Uuid
  requisitionId String       @db.Uuid
  verifiedById     String       @db.Uuid
  comment       String?
  decision      ITDecision
  verifiedAt    DateTime     @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  IT     User        @relation(fields: [verifiedById], references: [id])
}

// =========================
// 7. FINANCE APPROVAL
// =========================

model FinanceApproval {
  id            String         @id @default(uuid()) @db.Uuid
  requisitionId String         @db.Uuid
  approvedById  String         @db.Uuid
  decision      FinanceDecision
  comment       String?
  approvedAt    DateTime       @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approvedBy  User        @relation(fields: [approvedById], references: [id])
}

// =========================
// 8. STORES ISSUANCE
// =========================

model RequisitionIssuance {
  id            String   @id @default(uuid()) @db.Uuid
  requisitionId String   @unique @db.Uuid
  suppliedById  String   @db.Uuid
  issuedAt      DateTime @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  suppliedBy  User        @relation(fields: [suppliedById], references: [id])
}

// =========================
// 9. RECIPIENT RECEIPT
// =========================

model RequisitionReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  requisitionId String   @unique @db.Uuid
  recipientId   String   @db.Uuid
  signature     String?
  receivedAt    DateTime @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  recipient   User        @relation(fields: [recipientId], references: [id])
}

// =========================
// 10. REQUISITION HISTORY
// =========================

model RequisitionHistory {
  id            String           @id @default(uuid()) @db.Uuid
  requisitionId String           @db.Uuid
  performedById String           @db.Uuid
  action        RequisitionAction
  comment       String?
  createdAt     DateTime         @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  performedBy User        @relation(fields: [performedById], references: [id])
}

// =========================
// 11. EVIDENCE REQUEST
// =========================

model EvidenceRequest {
  id            String @id @default(uuid()) @db.Uuid

  // Requisition this evidence request belongs to
  requisitionId String      @db.Uuid
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  // Admin's request
  message       String
  requestedById String   @db.Uuid
  requestedBy   User     @relation("EvidenceRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  // Current evidence workflow status
  status EvidenceStatus @default(REQUESTED)

  // Staff confirms physical submission
  submittedById String?   @db.Uuid
  submittedBy   User?     @relation("EvidenceSubmittedBy", fields: [submittedById], references: [id])
  submissionNote String?
  submittedAt    DateTime?

  // Admin acknowledges physical receipt
  receivedById String?   @db.Uuid
  receivedBy   User?     @relation("EvidenceReceivedBy", fields: [receivedById], references: [id])
  receivedAt    DateTime?

  // Admin reviews the evidence
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
